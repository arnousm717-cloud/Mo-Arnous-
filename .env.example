# Copy to .env.local for local development. Never commit real values — see docs/08-Security.md §7.

# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Supabase Project Settings → Database → Connection pooling —
# must be the Supavisor pooler string (transaction mode, port 6543), never a
# direct Postgres connection (docs/02-Software-Architecture.md §2, ADR-004).
DATABASE_URL=
